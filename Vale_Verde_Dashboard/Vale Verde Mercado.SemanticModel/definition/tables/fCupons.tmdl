				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"UnidadeID", Int64.Type}, {"Data", type date}, {"FormaPagamento", type text}, {"Cupons", Int64.Type}, {"Itens", Int64.Type}, {"ValorBruto", type number}, {"Desconto", type number}, {"Receita", type number}, {"CMV", type number}, {"CuponsFidelidade", Int64.Type}})
				in
