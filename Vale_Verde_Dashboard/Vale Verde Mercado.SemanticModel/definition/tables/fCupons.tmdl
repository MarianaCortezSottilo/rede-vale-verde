	partition fCupons = m
		mode: import
		source =
				let
				  Origem = Csv.Document(File.Contents("C:\Users\macor\OneDrive\Documentos\Vale Verde\mercado_vale_verde\powerbi\dados\fCupons.csv"), [Delimiter = ";", Columns = 10, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
