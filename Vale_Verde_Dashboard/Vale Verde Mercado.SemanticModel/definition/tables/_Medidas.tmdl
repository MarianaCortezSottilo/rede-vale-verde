	column '_Coluna 1'
		dataType: string
		isHidden
		lineageTag: b2d9897f-a7e5-4d8a-90e9-94d5b182dfda
		summarizeBy: none
		sourceColumn: _Coluna 1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Medidas = m
		mode: import
		source =
				let
				  Origem = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Colunas Renomeadas" = Table.RenameColumns(Origem,{{"Coluna 1", "_Coluna 1"}})
				in
				  #"Colunas Renomeadas"

	annotation PBI_ResultType = Table

