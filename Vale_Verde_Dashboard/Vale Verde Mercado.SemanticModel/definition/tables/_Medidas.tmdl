		lineageTag: b0b7c34f-262d-4f62-9c87-300566c2b3e3

	measure 'Faturamento Mês Anterior' = CALCULATE ( [Faturamento], DATEADD ( dCalendario[Data], -1, MONTH ) )
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		displayFolder: Tempo
