	measure 'Faturamento Ano Anterior' =
			VAR ult = CALCULATE ( MAX ( fCupons[Data] ), ALL ( fCupons ) )
			RETURN CALCULATE ( [Faturamento], CALCULATETABLE ( SAMEPERIODLASTYEAR ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= ult ) ) )
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		displayFolder: Tempo
		lineageTag: f6ae9676-4b13-4212-8249-2bf9662fac73

	measure 'Crescimento vs AA %' = DIVIDE ( [Faturamento Comparável] - [Faturamento Ano Anterior], [Faturamento Ano Anterior] )
		formatString: 0.0%;-0.0%;0.0%
