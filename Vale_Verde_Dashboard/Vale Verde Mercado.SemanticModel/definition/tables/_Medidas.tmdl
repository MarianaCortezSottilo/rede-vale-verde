	measure 'Faturamento Acumulado Ano' = ```
			TOTALYTD ( [Faturamento], dCalendario[Data] )
			
			```
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		displayFolder: Tempo
		lineageTag: a7b685a6-1171-43e8-8026-722956cbd4cb

	/// Crescimento das lojas abertas há mais de 12 meses: compara o período escolhido (a partir do 13º mês de dados) com o mesmo período do ano anterior. Lojas inauguradas depois ficam de fora.
	measure 'Crescimento Mesmas Lojas %' =
			VAR ult = CALCULATE ( MAX ( fCupons[Data] ), ALL ( fCupons ) )
			VAR prim = CALCULATE ( MIN ( fCupons[Data] ), ALL ( fCupons ) )
			VAR iniComp = EDATE ( prim, 12 )
			VAR datas =
			    CALCULATETABLE (
			        VALUES ( dCalendario[Data] ),
			        KEEPFILTERS ( dCalendario[Data] >= iniComp ),
			        KEEPFILTERS ( dCalendario[Data] <= ult )
			    )
			VAR inicio = MINX ( datas, dCalendario[Data] )
			VAR lojas =
			    CALCULATETABLE (
			        VALUES ( dUnidade[UnidadeID] ),
			        KEEPFILTERS ( dUnidade[Tipo] = "LOJA" ),
			        KEEPFILTERS ( dUnidade[Inauguracao] <= EDATE ( inicio, -12 ) )
			    )
			VAR atual = CALCULATE ( [Faturamento], lojas, datas )
			VAR anterior = CALCULATE ( [Faturamento], lojas, CALCULATETABLE ( SAMEPERIODLASTYEAR ( dCalendario[Data] ), datas ) )
			RETURN IF ( ISEMPTY ( datas ) || ISEMPTY ( lojas ), BLANK (), DIVIDE ( atual - anterior, anterior ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Tempo
		lineageTag: b0cc0208-b1df-45f0-8af3-01c9e4c8d2cf

	measure 'Lojas com Venda' = ```
			CALCULATE ( DISTINCTCOUNT ( fCupons[UnidadeID] ), fCupons[Cupons] > 0 )
			
			```
		formatString: 0
		displayFolder: Tempo
		lineageTag: 5004b123-eada-4752-91f9-cb83fdd55521

	measure 'Faturamento por m² Ano' =
			
			VAR area =
			    SUMX ( FILTER ( VALUES ( dUnidade[UnidadeID] ), [Faturamento] > 0 ), CALCULATE ( MAX ( dUnidade[AreaM2] ) ) )
			VAR dias = DATEDIFF ( MIN ( fCupons[Data] ), MAX ( fCupons[Data] ), DAY ) + 1
			RETURN DIVIDE ( [Faturamento], area ) * DIVIDE ( 365, dias )
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		displayFolder: Tempo
		lineageTag: 048d7de2-b47e-46f5-9d18-dd8fc7303591

