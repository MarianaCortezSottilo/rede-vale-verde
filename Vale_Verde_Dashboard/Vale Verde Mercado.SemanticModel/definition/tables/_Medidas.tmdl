	measure 'Insight Crescimento' =
			
			VAR c = [Crescimento Mesmas Lojas %]
			RETURN
			    IF ( ISBLANK ( c ), "Sem base de comparação para o período.",
			        "Nas lojas com mais de 1 ano, o faturamento " & IF ( c >= 0, "cresceu ", "caiu " ) & FORMAT ( ABS ( c ), "0.0%" )
			            & " frente ao mesmo período do ano anterior." )
		displayFolder: Textos Dinâmicos
		lineageTag: 0c82b55c-31da-40db-ae42-106d7480b83e

	measure 'HTML Card Faturamento' = ```
			
			VAR v = [Faturamento]
			VAR c = [Crescimento vs AA %]
			VAR cor = IF ( c >= 0, "#0b7a0b", "#c0392b" )
			VAR seta = IF ( c >= 0, "▲", "▼" )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;padding:14px 16px;border-radius:12px;background:#fff;border:1px solid #e6e6e1'>"
			        & "<div style='font-size:12px;color:#6b6a66;letter-spacing:.02em'>FATURAMENTO</div>"
			        & "<div style='font-size:28px;font-weight:700;color:#0b0b0b;margin:4px 0'>R$ " & FORMAT ( v / 1000000, "#,0.0" ) & " mi</div>"
			        & "<div style='font-size:12px;font-weight:600;color:" & cor & "'>" & seta & " " & FORMAT ( ABS ( c ), "0.0%" ) & " vs ano anterior</div>"
			        & "</div>"
			
			
			```
		displayFolder: Visuais HTML
		lineageTag: 09e6a515-0871-4536-bf59-77dcd54d6daa

	measure 'HTML Ranking Lojas' = ```
			
			VAR maximo = MAXX ( ALLSELECTED ( dUnidade[Codigo] ), [Faturamento] )
			VAR linhas =
			    CONCATENATEX (
			        FILTER ( ALLSELECTED ( dUnidade[Codigo], dUnidade[Cidade], dUnidade[Modelo] ), [Faturamento] > 0 ),
			        VAR f = [Faturamento]
			        VAR largura = FORMAT ( DIVIDE ( f, maximo ) * 100, "0" )
			        VAR cor = IF ( dUnidade[Modelo] = "PROPRIA", "#2a78d6", "#eb6834" )
			        RETURN
			            "<div style='display:flex;align-items:center;gap:8px;margin:5px 0;font-size:12px'>"
			                & "<div style='width:120px;color:#333'>" & dUnidade[Codigo] & " " & dUnidade[Cidade] & "</div>"
			                & "<div style='flex:1;background:#f1f0ec;border-radius:4px;height:14px'>"
			                & "<div style='width:" & largura & "%;background:" & cor & ";height:14px;border-radius:4px'></div></div>"
			                & "<div style='width:70px;text-align:right;font-variant-numeric:tabular-nums'>R$ " & FORMAT ( f / 1000000, "#,0.0" ) & " mi</div></div>",
			        "",
			        [Faturamento], DESC
			    )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif'>"
			        & "<div style='font-size:12px;color:#6b6a66;margin-bottom:6px'>FATURAMENTO POR LOJA · <span style='color:#2a78d6'>■ própria</span> <span style='color:#eb6834'>■ franquia</span></div>"
			        & linhas & "</div>"
			
			```
		displayFolder: Visuais HTML
		lineageTag: 750ecf87-987e-42dc-9714-94719b975e33

	measure 'HTML Semáforo Frete' = ```
			
			VAR p = [Frete % Faturamento]
			VAR cor = SWITCH ( TRUE (), p > 0.02, "#c0392b", p > 0.01, "#b97800", "#0b7a0b" )
			VAR rotulo = SWITCH ( TRUE (), p > 0.02, "Crítico", p > 0.01, "Atenção", "Saudável" )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;display:flex;align-items:center;gap:10px'>"
			        & "<span style='width:14px;height:14px;border-radius:50%;background:" & cor & ";display:inline-block'></span>"
			        & "<span style='font-size:13px'><b>" & rotulo & "</b> · frete = " & FORMAT ( p, "0.00%" ) & " do faturamento</span></div>"
			
			```
		displayFolder: Visuais HTML
		lineageTag: 55ff706b-99ef-4228-ae4c-15cabf5580c6

	measure 'Cupons AA' =
			VAR ult = CALCULATE ( MAX ( fCupons[Data] ), ALL ( fCupons ) )
			RETURN CALCULATE ( [Cupons], CALCULATETABLE ( SAMEPERIODLASTYEAR ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= ult ) ) )
		formatString: #,0
		displayFolder: Tempo
		lineageTag: a1ea1cc9-a624-4b04-b39e-4159281cc15c

	measure 'CMV AA' =
			VAR ult = CALCULATE ( MAX ( fCupons[Data] ), ALL ( fCupons ) )
			RETURN CALCULATE ( [CMV], CALCULATETABLE ( SAMEPERIODLASTYEAR ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= ult ) ) )
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
