	measure 'Subtítulo Página' =
			VAR ini = CALCULATE ( MIN ( fCupons[Data] ), REMOVEFILTERS ( dUnidade ) )
			VAR fim = CALCULATE ( MAX ( fCupons[Data] ), REMOVEFILTERS ( dUnidade ) )
			VAR visao =
			    SWITCH (
			        TRUE (),
			        HASONEVALUE ( dUnidade[Loja] ), SELECTEDVALUE ( dUnidade[Loja] ),
			        ISFILTERED ( dUnidade[Modelo de Negócio] ) && HASONEVALUE ( dUnidade[Modelo de Negócio] ), SELECTEDVALUE ( dUnidade[Modelo de Negócio] ),
			        ISFILTERED ( dUnidade[Regiao] ) && HASONEVALUE ( dUnidade[Regiao] ), "Região " & SELECTEDVALUE ( dUnidade[Regiao] ),
			        "Rede completa"
			    )
			RETURN visao & "  ·  " & FORMAT ( ini, "mmm/yy" ) & " a " & FORMAT ( fim, "mmm/yy" )
		displayFolder: Textos Dinâmicos
		lineageTag: 670dcf72-d698-4fb4-9eb5-6181aa9237b9

	measure 'Card Var Faturamento' =
			VAR a = [Faturamento Comparável]
			VAR b = [Faturamento Ano Anterior]
			VAR v = DIVIDE ( a - b, b )
			RETURN IF ( ISBLANK ( b ) || ISBLANK ( a ), "sem base no ano anterior", IF ( v >= 0, "▲ ", "▼ " ) & FORMAT ( v, "+0.0%;-0.0%" ) & " vs ano anterior" )
		displayFolder: Cards
		lineageTag: 32a49390-28ea-410e-aebb-a0520963617e

	measure 'Card Cor Faturamento' =
			VAR a = [Faturamento Comparável]
			VAR b = [Faturamento Ano Anterior]
			RETURN IF ( ISBLANK ( b ) || ISBLANK ( a ), "#898781", IF ( a >= b, "#006300", "#D03B3B" ) )
		displayFolder: Cards
		lineageTag: 1a99b4e5-5ae5-4e17-801d-5fcb2706e9e4

