		sourceColumn: QtdNaoAtendida

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Venda perdida estimada, em R$ (quantidade × preço).
	column VendaPerdida
		dataType: double
		lineageTag: 4a960ad5-52f4-4c0f-acb5-0576a3c4be21
		summarizeBy: sum
		sourceColumn: VendaPerdida

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition fRupturas = m
		mode: import
		source =
				let
				  Origem = Csv.Document(File.Contents("C:\Users\macor\OneDrive\Documentos\Vale Verde\mercado_vale_verde\powerbi\dados\fRupturas.csv"), [Delimiter = ";", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"UnidadeID", Int64.Type}, {"Data", type date}, {"ProdutoID", Int64.Type}, {"QtdNaoAtendida", type number}, {"VendaPerdida", type number}})
				in
				  #"Tipo de coluna alterado"

	annotation PBI_ResultType = Table

