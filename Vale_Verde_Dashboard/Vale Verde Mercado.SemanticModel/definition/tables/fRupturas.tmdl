		isHidden
		formatString: 0
		lineageTag: 0aec45ce-e814-4a64-b8a4-c8fc46cd4ad2
		summarizeBy: none
		sourceColumn: UnidadeID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Dia da falta.
	column Data
		dataType: dateTime
		formatString: Long Date
		lineageTag: fc744381-e745-4ad0-91cd-7ba2b628b0b7
		summarizeBy: none
		sourceColumn: Data

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Produto em falta.
	column ProdutoID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 16a0b3d5-ea0d-464b-8e87-b6b5b3ea5b72
		summarizeBy: none
