				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"ClienteID", Int64.Type}, {"UnidadeID", Int64.Type}, {"Sexo", type text}, {"Bairro", type text}, {"Latitude", type number}, {"Longitude", type number}, {"DistanciaKm", type number}, {"FaixaDistancia", type text}, {"Cadastro", type date}, {"Compras6m", Int64.Type}, {"Valor6m", type number}})
				in
				  #"Tipo de coluna alterado"

	annotation PBI_ResultType = Table

